<UserControl x:Class="CBServersPlaynite.CBServersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CBServersPlaynite"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0A0E13" Offset="0" />
            <GradientStop Color="#07090C" Offset="1" />
        </LinearGradientBrush>
    </UserControl.Background>

    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVis" />
        <local:NullToVisibilityConverter x:Key="NullToVis" />

        <SolidColorBrush x:Key="Accent" Color="#FF6A1A" />
        <SolidColorBrush x:Key="TextMain" Color="#E9EEF4" />
        <SolidColorBrush x:Key="TextMuted" Color="#8290A0" />

        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Foreground" Value="#DCE5EE" />
            <Setter Property="Background" Value="#11161D" />
            <Setter Property="BorderBrush" Value="#26313D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="4" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1A222C" />
                                <Setter TargetName="b" Property="BorderBrush" Value="#3A4655" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#0C1015" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#0A0C0F" />
            <Setter Property="Background" Value="#FF6A1A" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="4" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#FF833F" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#D9540E" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Background" Value="#3A2A20" />
                                <Setter Property="Foreground" Value="#8A7565" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="TabToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#8794A3" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="bg" CornerRadius="4" Background="Transparent" Padding="16,8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="line" Height="2" VerticalAlignment="Bottom" Background="Transparent" Margin="10,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#10151C" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#141A22" />
                                <Setter TargetName="line" Property="Background" Value="#FF6A1A" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#6E7B8A" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="RowsHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#6E7B8A" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="FilterChip" TargetType="ToggleButton">            <Setter Property="Foreground" Value="#8794A3" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="b" Background="#0F141A" BorderBrush="#1E2732" BorderThickness="1" CornerRadius="4" Padding="10,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="#3A4655" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#2A1608" />
                                <Setter TargetName="b" Property="BorderBrush" Value="#FF6A1A" />
                                <Setter Property="Foreground" Value="#FFB35C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#0F141A" />
            <Setter Property="Foreground" Value="#E9EEF4" />
            <Setter Property="CaretBrush" Value="#FF6A1A" />
            <Setter Property="BorderBrush" Value="#26313D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SelectionBrush" Value="#FF6A1A" />
        </Style>

        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="#0E1218" />
            <Setter Property="BorderBrush" Value="#1B232C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#0F141A" />
            <Setter Property="BorderBrush" Value="#1B232C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#FF6A1A" />
                    <Setter Property="Background" Value="#111821" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToggleCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D7E0EA" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="box" Width="18" Height="18" Background="#0F141A" BorderBrush="#2A3542" BorderThickness="1" CornerRadius="3">
                                <TextBlock x:Name="mark" Text="✓" FontSize="11" FontWeight="Bold" Foreground="#0A0C0F"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="#3A4655" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="#FF6A1A" />
                                <Setter TargetName="box" Property="BorderBrush" Value="#FF6A1A" />
                                <Setter TargetName="mark" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#12171E" />
            <Setter Property="Foreground" Value="#E9EEF4" />
            <Setter Property="BorderBrush" Value="#26313D" />
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10" />
            <Setter Property="MinWidth" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#2A3542" CornerRadius="4" Margin="2" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="Height" Value="10" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#E9EEF4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,6" />
        </Style>

        <DataTemplate x:Key="FriendRowTemplate">
            <Border Background="#0F141A" BorderBrush="#1B232C" BorderThickness="1" CornerRadius="6" Padding="12,9" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Border CornerRadius="20" Background="{Binding AvatarBrush}">
                            <TextBlock Text="{Binding Initials}" FontSize="13" FontWeight="Bold" Foreground="#0B0F14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Ellipse Width="11" Height="11" Fill="{Binding PresenceBrush}" Stroke="#0F141A" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding NameText}" FontSize="12" FontWeight="SemiBold" Foreground="#E9EEF4" TextTrimming="CharacterEllipsis" MaxWidth="520" />
                            <TextBlock Text="{Binding HandleText}" FontSize="10" Foreground="#6E7B8A" Margin="8,2,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding PresenceText}" FontSize="10" Foreground="{Binding PresenceBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Button Grid.Column="2" Content="✕" Style="{StaticResource IconButton}" ToolTip="Quitar amigo" Click="RemoveFriend_Click" Tag="{Binding}" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="IncomingRowTemplate">
            <Border Background="#0F141A" BorderBrush="#1B232C" BorderThickness="1" CornerRadius="6" Padding="12,9" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Border CornerRadius="20" Background="{Binding AvatarBrush}">
                            <TextBlock Text="{Binding Initials}" FontSize="13" FontWeight="Bold" Foreground="#0B0F14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding NameText}" FontSize="12" FontWeight="SemiBold" Foreground="#E9EEF4" TextTrimming="CharacterEllipsis" MaxWidth="520" />
                            <TextBlock Text="{Binding HandleText}" FontSize="10" Foreground="#6E7B8A" Margin="8,2,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="Quiere ser tu amigo en CB" FontSize="10" Foreground="#FFB35C" Margin="0,3,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="ACEPTAR" Style="{StaticResource PrimaryButton}" Padding="10,4" Click="AcceptFriend_Click" Tag="{Binding}" />
                        <Button Content="✕" Style="{StaticResource IconButton}" ToolTip="Rechazar" Margin="6,0,0,0" Click="DeclineFriend_Click" Tag="{Binding}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="OutgoingRowTemplate">
            <Border Background="#0F141A" BorderBrush="#1B232C" BorderThickness="1" CornerRadius="6" Padding="12,9" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Border CornerRadius="20" Background="{Binding AvatarBrush}">
                            <TextBlock Text="{Binding Initials}" FontSize="13" FontWeight="Bold" Foreground="#0B0F14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding NameText}" FontSize="12" FontWeight="SemiBold" Foreground="#E9EEF4" TextTrimming="CharacterEllipsis" MaxWidth="520" />
                            <TextBlock Text="{Binding HandleText}" FontSize="10" Foreground="#6E7B8A" Margin="8,2,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="Solicitud enviada · esperando respuesta" FontSize="10" Foreground="#7F8C9A" Margin="0,3,0,0" />
                    </StackPanel>

                    <Button Grid.Column="2" Content="CANCELAR" Style="{StaticResource PillButton}" Click="CancelFriend_Click" Tag="{Binding}" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0B0F14" BorderBrush="#1A222B" BorderThickness="0,0,0,1" Padding="22,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="3" Height="30" CornerRadius="2" Background="#FF6A1A" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <Image x:Name="HeaderLogo" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="CB SERVERS" FontFamily="Bahnschrift, Segoe UI" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF" />
                        <TextBlock Text="PLAYNITE INTEGRATION" FontSize="9" Foreground="#6E7B8A" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ToggleButton x:Name="TabGames" Content="JUEGOS" Style="{StaticResource TabToggle}" IsChecked="True" Click="Tab_Click" Tag="games" />
                    <ToggleButton x:Name="TabServers" Content="SERVIDORES" Style="{StaticResource TabToggle}" Margin="4,0" Click="Tab_Click" Tag="servers" />
                    <ToggleButton x:Name="TabFriends" Content="AMIGOS" Style="{StaticResource TabToggle}" Margin="0,0,4,0" Click="Tab_Click" Tag="friends" />
                    <ToggleButton x:Name="TabSettings" Content="AJUSTES" Style="{StaticResource TabToggle}" Click="Tab_Click" Tag="settings" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,38,0">
                    <Border Background="#0F141A" BorderBrush="#1E2732" BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#5A6673" VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusLabel" Text="CB CERRADO" FontSize="9" FontWeight="SemiBold" Foreground="#9AA7B4" Margin="6,0,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Background="#0F141A" BorderBrush="#1E2732" BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="0,0,8,0">
                        <TextBlock x:Name="PlayerLabel" Text="INVITADO" FontSize="9" FontWeight="SemiBold" Foreground="#FFB35C" />
                    </Border>
                    <Button Content="ABRIR CB" Style="{StaticResource PillButton}" Click="OpenLauncher_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">

            <!-- ============ JUEGOS ============ -->
            <Grid x:Name="GamesTab" Margin="22,16,22,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="BIBLIOTECA" FontFamily="Bahnschrift, Segoe UI" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" />
                        <TextBlock x:Name="GamesCountText" Text="" FontSize="10" Foreground="#6E7B8A" Margin="12,3,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <ToggleButton x:Name="FilterAll" Content="TODOS" Style="{StaticResource FilterChip}" IsChecked="True" Click="Filter_Click" Tag="all" />
                        <ToggleButton x:Name="FilterInstalled" Content="INSTALADOS" Style="{StaticResource FilterChip}" Click="Filter_Click" Tag="installed" />
                        <ToggleButton x:Name="FilterMissing" Content="NO INSTALADOS" Style="{StaticResource FilterChip}" Click="Filter_Click" Tag="missing" />
                        <Grid Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBox x:Name="GameSearch" Width="210" Style="{StaticResource DarkTextBox}" ToolTip="Buscar juego" TextChanged="GameSearch_TextChanged" />
                            <TextBlock Text="Buscar juego" Foreground="#5F6B79" FontSize="11" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=GameSearch}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="GamesPanel">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="304" Height="212" Margin="0,0,14,14" Style="{StaticResource CardBorder}" CornerRadius="7" ClipToBounds="True">
                                    <Grid>
                                        <Grid.Clip>
                                            <RectangleGeometry Rect="0,0,302,210" RadiusX="6" RadiusY="6" />
                                        </Grid.Clip>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="150" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" MouseLeftButtonUp="CardOpen_Click" Tag="{Binding}">
                                            <Border Background="#141B23" />
                                            <Image Source="{Binding CapsulePath}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                            <Border VerticalAlignment="Bottom" Height="80">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#000F141A" Offset="0" />
                                                        <GradientStop Color="#F20F141A" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>

                                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Background="#CC0A0D11"
                                                    BorderBrush="#26313D" BorderThickness="1" CornerRadius="3" Padding="7,2">
                                                <TextBlock Text="{Binding StatusBadge}" FontSize="8" FontWeight="Bold" Foreground="#C9D4E0" />
                                            </Border>

                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Background="#CC0A0D11"
                                                    BorderBrush="#26313D" BorderThickness="1" CornerRadius="3" Padding="7,2"
                                                    Visibility="{Binding OnlineVisibility}">
                                                <TextBlock Text="{Binding OnlineShort}" FontSize="8" FontWeight="Bold" Foreground="#35D399" />
                                            </Border>
                                        </Grid>

                                        <Grid Grid.Row="1" Margin="12,8,12,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="#E9EEF4" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding SubText}" FontSize="10" Foreground="#7F8C9A" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                                <Button Content="{Binding PlayButtonText}" Style="{StaticResource PrimaryButton}" Click="Play_Click" Tag="{Binding}" />
                                                <Button Content="•••" Style="{StaticResource PillButton}" Padding="8,4" Margin="5,0,0,0" Click="Menu_Click" Tag="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock x:Name="GamesEmpty" Grid.Row="1" Text="No hay juegos que coincidan con el filtro."
                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#6E7B8A" FontSize="12" Visibility="Collapsed" />
            </Grid>

            <!-- ============ SERVIDORES ============ -->
            <Grid x:Name="ServersTab" Margin="22,16,22,10" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="SERVIDORES" FontFamily="Bahnschrift, Segoe UI" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" />
                        <TextBlock x:Name="ServersUpdatedText" Text="" FontSize="10" Foreground="#6E7B8A" Margin="12,3,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Grid VerticalAlignment="Center">
                            <TextBox x:Name="ServerSearch" Width="200" Style="{StaticResource DarkTextBox}" ToolTip="Filtrar por nombre, mapa o IP" TextChanged="ServerSearch_TextChanged" />
                            <TextBlock Text="Buscar servidor" Foreground="#5F6B79" FontSize="11" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=ServerSearch}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Button Content="ACTUALIZAR" Style="{StaticResource PillButton}" Margin="8,0,0,0" Click="RefreshServers_Click" />
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,10">
                    <ListBox x:Name="ServerGameList" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="ServerGame_SelectionChanged">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0,0,6,6" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="b" Background="#0F141A" BorderBrush="#1E2732" BorderThickness="1" CornerRadius="4" Padding="10,5">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="BorderBrush" Value="#3A4655" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="#2A1608" />
                                                    <Setter TargetName="b" Property="BorderBrush" Value="#FF6A1A" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ShortName}" FontSize="10" FontWeight="SemiBold" Foreground="#D7E0EA" />
                                    <TextBlock Text="{Binding OnlinePlayers, StringFormat=' · {0}'}" FontSize="10" Foreground="#7F8C9A" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>

                <Grid Grid.Row="2" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="230" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="SERVIDOR" FontSize="9" FontWeight="SemiBold" Foreground="#6E7B8A" Margin="10,0,0,0" />
                    <TextBlock Grid.Column="1" Text="MODO" FontSize="9" FontWeight="SemiBold" Foreground="#6E7B8A" />
                    <TextBlock Grid.Column="2" Text="JUGADORES" FontSize="9" FontWeight="SemiBold" Foreground="#6E7B8A" />
                    <TextBlock Grid.Column="3" Text="REGIÓN" FontSize="9" FontWeight="SemiBold" Foreground="#6E7B8A" />
                </Grid>

                <Grid Grid.Row="3">
                    <ListBox x:Name="ServersList" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#0F141A" BorderBrush="#1B232C" BorderThickness="1" Margin="0,0,0,6" Padding="10,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="230" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="#1C2632" CornerRadius="3" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center"
                                                        Visibility="{Binding TagVisibility}">
                                                    <TextBlock Text="{Binding TagText}" FontSize="8" FontWeight="Bold" Foreground="#FFB35C" />
                                                </Border>
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="#E9EEF4" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding SubText}" FontSize="10" Foreground="#7F8C9A" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" Text="{Binding ModeText}" FontSize="10" FontWeight="SemiBold" Foreground="#C9D4E0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding PlayersText}" FontSize="11" FontWeight="SemiBold" Foreground="#35D399" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding RegionText}" FontSize="10" Foreground="#9AA7B4" VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Content="COPIAR IP" Style="{StaticResource PillButton}" Padding="8,4" Click="CopyIp_Click" Tag="{Binding}" />
                                            <Button Content="ABRIR EN CB" Style="{StaticResource PrimaryButton}" Padding="10,4" Margin="5,0,0,0" Click="OpenServerGame_Click" Tag="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="ServersEmpty" Text="Selecciona un juego para ver sus servidores."
                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#6E7B8A" FontSize="12" />
                </Grid>
            </Grid>

            <!-- ============ AMIGOS ============ -->
            <Grid x:Name="FriendsTab" Margin="22,16,22,10" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="AMIGOS" FontFamily="Bahnschrift, Segoe UI" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" />
                        <Border Background="#0F141A" BorderBrush="#1E2732" BorderThickness="1" CornerRadius="10" Padding="9,3" Margin="12,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="FriendsStateDot" Width="6" Height="6" Fill="#5A6673" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock x:Name="FriendsCountText" Text="—" FontSize="9" FontWeight="SemiBold" Foreground="#9AA7B4" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="FriendActionsPanel" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Grid VerticalAlignment="Center">
                            <TextBox x:Name="FriendHandleBox" Width="180" Style="{StaticResource DarkTextBox}" ToolTip="Handle de CB, por ejemplo LOLJavier69" KeyDown="FriendHandle_KeyDown" />
                            <TextBlock Text="Handle de CB" Foreground="#5F6B79" FontSize="11" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=FriendHandleBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Button Content="AGREGAR" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="AddFriend_Click" />
                        <Button Content="ACTUALIZAR" Style="{StaticResource PillButton}" Margin="8,0,0,0" Click="RefreshFriends_Click" />
                    </StackPanel>
                </Grid>

                <Border x:Name="FriendsSetupPanel" Grid.Row="1" Style="{StaticResource Panel}" Margin="0,0,0,12" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="CONECTA TU CUENTA DE CB" FontSize="9" FontWeight="Bold" Foreground="#FFB35C" />
                            <TextBlock x:Name="FriendsSetupText" TextWrapping="Wrap" FontSize="11" Foreground="#C9D4E0" Margin="0,6,18,0"
                                       Text="El plugin puede descargar CB Launcher por ti. Ábrelo una vez e inicia sesión: tus amigos aparecerán aquí automáticamente." />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="FriendsDownloadButton" Content="DESCARGAR CB" Style="{StaticResource PrimaryButton}" Click="FriendsDownload_Click" />
                            <Button Content="REINTENTAR" Style="{StaticResource PillButton}" Margin="8,0,0,0" Click="FriendsRetry_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <ScrollViewer x:Name="FriendsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock x:Name="FriendsErrorText" FontSize="10" Foreground="#FF8A8A" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed" />

                            <StackPanel x:Name="RequestsSection" Visibility="Collapsed">
                                <TextBlock x:Name="RequestsHeader" Text="SOLICITUDES" Style="{StaticResource RowsHeader}" Margin="0,0,0,8" />
                                <ItemsControl x:Name="IncomingList" ItemTemplate="{StaticResource IncomingRowTemplate}" />
                                <ItemsControl x:Name="OutgoingList" ItemTemplate="{StaticResource OutgoingRowTemplate}" Margin="0,0,0,4" />
                            </StackPanel>

                            <StackPanel x:Name="OnlineSection" Visibility="Collapsed">
                                <Grid Margin="0,14,0,8">
                                    <TextBlock x:Name="OnlineHeader" Text="EN LÍNEA" Style="{StaticResource RowsHeader}" />
                                </Grid>
                                <ItemsControl x:Name="OnlineFriendList" ItemTemplate="{StaticResource FriendRowTemplate}" />
                            </StackPanel>

                            <StackPanel x:Name="OfflineSection" Visibility="Collapsed">
                                <Grid Margin="0,14,0,8">
                                    <TextBlock x:Name="OfflineHeader" Text="DESCONECTADOS" Style="{StaticResource RowsHeader}" />
                                </Grid>
                                <ItemsControl x:Name="OfflineFriendList" ItemTemplate="{StaticResource FriendRowTemplate}" />
                            </StackPanel>

                            <Border x:Name="FriendsEmptyPanel" Visibility="Collapsed" Background="#0E1218" BorderBrush="#1B232C" BorderThickness="1" CornerRadius="8" Padding="28" Margin="0,6,0,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="48" Height="48" CornerRadius="24" Background="#141B23" BorderBrush="#1E2732" BorderThickness="1" HorizontalAlignment="Center">
                                        <TextBlock Text="+" FontFamily="Bahnschrift, Segoe UI" FontSize="24" FontWeight="Light" Foreground="#FF6A1A"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0" />
                                    </Border>
                                    <TextBlock x:Name="FriendsEmptyTitle" Text="Todavía no tienes amigos en CB" FontSize="13" FontWeight="SemiBold" Foreground="#E9EEF4"
                                               HorizontalAlignment="Center" Margin="0,14,0,0" />
                                    <TextBlock x:Name="FriendsEmptyText" Text="Escribe el handle de alguien arriba y pulsa AGREGAR para enviarle una solicitud."
                                               FontSize="11" Foreground="#7F8C9A" HorizontalAlignment="Center" Margin="0,6,0,0" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- ============ AJUSTES ============ -->
            <Grid x:Name="SettingsTab" Margin="22,16,22,10" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="820" HorizontalAlignment="Left">
                        <TextBlock Text="AJUSTES" FontFamily="Bahnschrift, Segoe UI" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,14" />

                        <Border Style="{StaticResource Panel}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="LAUNCHER" FontSize="9" FontWeight="Bold" Foreground="#6E7B8A" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="LauncherPathBox" Style="{StaticResource DarkTextBox}" />
                                    <Button Grid.Column="1" Content="EXAMINAR" Style="{StaticResource PillButton}" Margin="8,0,0,0" Click="BrowseLauncher_Click" />
                                    <Button Grid.Column="2" Content="DETECTAR" Style="{StaticResource PillButton}" Margin="6,0,0,0" Click="DetectLauncher_Click" />
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="DESCARGAR CB AUTOMÁTICAMENTE" Style="{StaticResource PrimaryButton}" Click="DownloadLauncher_Click" />
                                    <TextBlock x:Name="LauncherStateText" Text="" FontSize="10" Foreground="#7F8C9A" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Si no tienes CB Launcher, el plugin lo descarga desde el GitHub oficial y verifica su SHA-256 antes de usarlo."
                                           FontSize="9" Foreground="#5F6B79" Margin="0,6,0,0" TextWrapping="Wrap" />

                                <TextBlock Text="CARPETA DE DATOS" FontSize="9" FontWeight="Bold" Foreground="#6E7B8A" Margin="0,16,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="DataPathText" FontSize="11" Foreground="#C9D4E0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Button Grid.Column="1" Content="ABRIR" Style="{StaticResource PillButton}" Click="OpenDataFolder_Click" />
                                </Grid>

                                <TextBlock Text="JUGADOR" FontSize="9" FontWeight="Bold" Foreground="#6E7B8A" Margin="0,16,0,6" />
                                <TextBlock x:Name="PlayerNameText" FontSize="11" Foreground="#FFB35C" />

                                <TextBlock Text="OPCIONES DEL LAUNCHER" FontSize="9" FontWeight="Bold" Foreground="#6E7B8A" Margin="0,16,0,10" />
                                <CheckBox x:Name="CloseOnLaunchCheck" Style="{StaticResource ToggleCheck}" Content="Cerrar CB Launcher al lanzar un juego" Margin="0,0,0,10" Click="CloseOnLaunch_Click" />
                                <CheckBox x:Name="OfflineCheck" Style="{StaticResource ToggleCheck}" Content="Arrancar CB Launcher en modo offline" Click="Offline_Click" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Panel}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="MANTENIMIENTO" FontSize="9" FontWeight="Bold" Foreground="#6E7B8A" Margin="0,0,0,10" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="ABRIR CB LAUNCHER" Style="{StaticResource PrimaryButton}" Click="OpenLauncher_Click" />
                                    <Button Content="RECARGAR DATOS" Style="{StaticResource PillButton}" Margin="8,0,0,0" Click="ReloadData_Click" />
                                    <Button Content="ABRIR CARPETA DE DATOS" Style="{StaticResource PillButton}" Margin="8,0,0,0" Click="OpenDataFolder_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="#5F6B79" Margin="0,4,0,0"
                                   Text="La descarga, verificación e instalación de archivos las realiza el motor de CB Servers Launcher; este panel lo controla mediante sus enlaces oficiales. Tu identidad de CB se usa solo en tu PC para firmar las peticiones de amigos y nunca se envía a terceros. Arte y launcher © CB Servers, GPLv3. Plugin no oficial." />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ============ DETALLE ============ -->
            <Grid x:Name="DetailOverlay" Visibility="Collapsed" Background="#E6080B0F" MouseLeftButtonDown="Overlay_Click">
                <Border Width="560" MaxHeight="680" Background="#0E1218" BorderBrush="#26313D" BorderThickness="1"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Grid Height="230" MouseLeftButtonDown="DetailInner_Click">
                                <Border Background="#141B23" />
                                <Image x:Name="DetailHero" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                <Border VerticalAlignment="Bottom" Height="150">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#000E1218" Offset="0" />
                                            <GradientStop Color="#FF0E1218" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Button Content="✕" Style="{StaticResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Click="CloseDetail_Click" />
                                <StackPanel VerticalAlignment="Bottom" Margin="20">
                                    <Image x:Name="DetailLogo" Height="42" HorizontalAlignment="Left" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <TextBlock x:Name="DetailName" FontFamily="Bahnschrift, Segoe UI" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,8,0,2" />
                                    <TextBlock x:Name="DetailOnline" FontSize="11" Foreground="#35D399" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="20,16,20,20" MouseLeftButtonDown="DetailInner_Click">
                                <TextBlock Text="MODOS DE JUEGO" FontSize="9" FontWeight="Bold" Foreground="#6E7B8A" Margin="0,0,0,8" />
                                <WrapPanel x:Name="DetailModes" />

                                <TextBlock Text="INSTALACIÓN" FontSize="9" FontWeight="Bold" Foreground="#6E7B8A" Margin="0,12,0,6" />
                                <TextBlock x:Name="DetailPath" FontSize="10" Foreground="#9AA7B4" TextWrapping="Wrap" />

                                <WrapPanel Margin="0,18,0,0">
                                    <Button x:Name="DetailPlay" Content="JUGAR" Style="{StaticResource PrimaryButton}" Margin="0,0,6,6" Click="DetailPlay_Click" />
                                    <Button x:Name="DetailInstall" Content="INSTALAR / ACTUALIZAR" Style="{StaticResource PillButton}" Margin="0,0,6,6" Click="DetailInstall_Click" />
                                    <Button Content="ABRIR FICHA EN CB" Style="{StaticResource PillButton}" Margin="0,0,6,6" Click="DetailOpenPage_Click" />
                                    <Button Content="MODS" Style="{StaticResource PillButton}" Margin="0,0,6,6" Click="DetailMods_Click" />
                                    <Button Content="ABRIR CARPETA" Style="{StaticResource PillButton}" Margin="0,0,6,6" Click="DetailFolder_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#0B0F14" BorderBrush="#1A222B" BorderThickness="0,1,0,0" Padding="22,5">
            <Grid>
                <TextBlock x:Name="StatusLine" Text="Listo" FontSize="9" Foreground="#5F6B79" VerticalAlignment="Center" />
                <TextBlock x:Name="VersionLabel" Text="v1.1.0" FontSize="9" Foreground="#3F4954" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
